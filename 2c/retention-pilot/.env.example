# Copy this file to .env only if you want real model drafts. Dry runs need nothing here.
# Never share or upload your .env file. Keys stay on your computer.

# Which model API drafts the messages: mock (no network), anthropic, openai or gemini
PROVIDER=mock

# Claude (pip install anthropic)
ANTHROPIC_API_KEY=
# Configurable default. Model names change: check the provider's current model list before a real run.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# "default" lets the API retry a safety-declined request on a fallback model. Set off to disable.
ANTHROPIC_FALLBACKS=default
ANTHROPIC_MAX_TOKENS=16000

# OpenAI (pip install openai). Not tested against a live API in this kit.
OPENAI_API_KEY=
# Configurable default. Check current model names before use.
OPENAI_MODEL=gpt-5.5

# Gemini (pip install google-genai). Not tested against a live API in this kit.
GEMINI_API_KEY=
# Configurable default. Check current model names before use.
GEMINI_MODEL=gemini-3.8-flash

# For teaching only: make the mock model refuse, truncate or error (ok | refuse | truncate | error)
MOCK_BEHAVIOR=ok
