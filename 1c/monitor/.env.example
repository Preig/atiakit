# AI answer monitor settings.
# Copy this file to .env and fill in what you need. Never commit .env or share it.
# Settings are read from (highest first): your environment, .env, settings.env, this file.
# Model and tool names below were current on 2026-10-10. Providers rename them often:
# check each provider's current model list and search tool docs, then run
#   python monitor.py check

# ---- Keys (leave blank to skip a provider) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- Which providers to ask (comma list) ----
PROVIDERS=anthropic,openai,gemini

# ---- Claude (Anthropic Messages API + server-side web search tool) ----
# Check: Anthropic models overview and the web search tool page.
ANTHROPIC_MODEL=claude-opus-5-5
# Fallback tool type that current models accept: web_search_20250305
ANTHROPIC_WEB_SEARCH_TOOL=web_search_20260318
ANTHROPIC_MAX_SEARCHES=5
ANTHROPIC_MAX_TOKENS=16000
# low, medium, high (blank = leave out; some older models reject it)
ANTHROPIC_EFFORT=medium
# default = rerun a declined request on the API's recommended fallback model; off = disable
ANTHROPIC_FALLBACKS=default
# Prices in USD, checked 2026-10-10. Confirm on the Anthropic pricing page.
ANTHROPIC_PRICE_INPUT_PER_MTOK=4.00
ANTHROPIC_PRICE_OUTPUT_PER_MTOK=20.00
ANTHROPIC_PRICE_PER_1K_SEARCHES=10.00

# ---- OpenAI (Responses API + web_search tool) ----
# Check: OpenAI web search guide and model list.
OPENAI_MODEL=gpt-5.5
OPENAI_WEB_SEARCH_TOOL=web_search
# low, medium, high (blank = provider default)
OPENAI_SEARCH_CONTEXT_SIZE=
OPENAI_INCLUDE_SOURCES=1
OPENAI_MAX_OUTPUT_TOKENS=16000
# Token prices for your model: copy them from the OpenAI pricing page (left blank on purpose).
OPENAI_PRICE_INPUT_PER_MTOK=
OPENAI_PRICE_OUTPUT_PER_MTOK=
# Web search tool calls, USD per 1,000 calls, checked 2026-10-10. Search content tokens are billed at model rates.
OPENAI_PRICE_PER_1K_SEARCHES=10.00

# ---- Gemini (google-genai + Grounding with Google Search) ----
# Check: Gemini models list and the Grounding with Google Search page.
GEMINI_MODEL=gemini-3.8-flash
# interactions (current docs) or generate_content (older style; confirm against your SDK)
GEMINI_API_STYLE=interactions
GEMINI_SEARCH_TOOL=google_search
# Resolve Google redirect links in citations with one HEAD request each (1 = yes)
GEMINI_RESOLVE_REDIRECTS=1
# Token prices for your model: copy them from the Gemini pricing page (left blank on purpose).
GEMINI_PRICE_INPUT_PER_MTOK=
GEMINI_PRICE_OUTPUT_PER_MTOK=
# Search queries, checked 2026-10-10: free allowance per month, then USD per 1,000 queries.
GEMINI_FREE_SEARCHES_PER_MONTH=5000
GEMINI_PRICE_PER_1K_SEARCHES=14.00

# ---- Budget stop ----
# The run stops before an answer that would push this month's measured spend past the budget.
# "none" turns the stop off (not recommended).
MONTHLY_BUDGET=25
# Used for the first answers of a month, before there is a measured average.
EST_COST_PER_ANSWER=0.10
# 1 = allow providers whose prices are not set (their spend is then not counted)
ALLOW_UNPRICED=0

# ---- What gets stored ----
# Full answer text in answers.jsonl, per provider (1 = store, 0 = keep only names found, citations and usage).
# Contractual: if you show stored answers to anyone, show their citations too (Anthropic and OpenAI terms).
# Contractual: check the Gemini API terms before storing full grounded answers; off by default.
STORE_FULL_TEXT_ANTHROPIC=1
STORE_FULL_TEXT_OPENAI=1
STORE_FULL_TEXT_GEMINI=0

# ---- Panel settings (keep them fixed so weeks stay comparable) ----
# Approximate traveler location sent with the search tool (Claude and OpenAI). USER_LOCATION=off sends none.
USER_COUNTRY=US
USER_REGION=
USER_CITY=
USER_TIMEZONE=
# Same instruction for every provider. Blank = the built-in neutral one.
PANEL_INSTRUCTION=
# Seconds between calls
SLEEP_BETWEEN_CALLS=1
# Where results go (relative to this folder)
OUTPUT_DIR=output
